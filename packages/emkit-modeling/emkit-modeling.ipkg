package emkit-modeling
version = 0.1.0
authors = "Jonas Isberg"
maintainers = "Jonas Isberg"
readme = "README.md"
brief = "Event Modeling runtime helpers and contracts for Idris2."

sourcedir = "src"

modules = EmKit.Modeling.Pattern.CommandStateChange
        , EmKit.Modeling.Pattern.Automation
        , EmKit.Modeling.Pattern.Translation
        , EmKit.Modeling.Screen.Contracts
        , EmKit.Modeling.Screen.Actions
        , EmKit.Modeling.Traceability.Slice

depends = base
        , emkit-sourcing
