package emkit-backend
version = 0.1.1
authors = "Jonas Isberg"
maintainers = "Jonas Isberg"
readme = "README.md"
brief = "Shared backend adapters for event-oriented Idris2 web applications."

sourcedir = "src"

modules = EmKit.Backend.SSE
        , EmKit.Backend.StoreApp

depends = base
        , contrib
        , node
        , tyttp
        , emkit-runtime
        , emkit-store
        , emkit-stream
