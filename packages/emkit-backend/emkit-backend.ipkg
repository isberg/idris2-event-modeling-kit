package emkit-backend
version = 0.1.1
authors = "Jonas Isberg"
maintainers = "Jonas Isberg"
readme = "README.md"
brief = "Shared backend adapters for event-oriented Idris2 web applications."
license = "MIT"
homepage = "https://github.com/isberg/idris2-event-modeling-kit"
sourceloc = "https://github.com/isberg/idris2-event-modeling-kit"
bugtracker = "https://github.com/isberg/idris2-event-modeling-kit/issues"

sourcedir = "src"

modules = EmKit.Backend.SSE
        , EmKit.Backend.StoreApp

depends = base
        , contrib
        , node
        , tyttp
        , emkit-runtime
        , emkit-store
        , emkit-stream
