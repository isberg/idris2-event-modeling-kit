package emkit-wire
version = 0.1.0
authors = "Jonas Isberg"
maintainers = "Jonas Isberg"
readme = "README.md"
brief = "Shared wire contracts and JSON codecs for event-oriented applications."
license = "MIT"
homepage = "https://github.com/isberg/idris2-event-modeling-kit"
sourceloc = "https://github.com/isberg/idris2-event-modeling-kit"
bugtracker = "https://github.com/isberg/idris2-event-modeling-kit/issues"

sourcedir = "src"

modules = EmKit.Wire.Contracts
        , EmKit.Wire.JSON
        , EmKit.Wire.JSON.Simple

depends = base
        , json
        , json-simple
